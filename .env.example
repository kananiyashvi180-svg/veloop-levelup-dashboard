# VLOOP Level-Up Rewards Platform - Environment Template
# Copy this file to .env or .env.local and adjust your settings

# Application Title & Branding
VITE_APP_TITLE="VELOOP Rewards — Level-Up Dashboard"

# Environment mode: development | production | staging
VITE_APP_ENV=production

# App version
VITE_APP_VERSION=1.0.0

# Backend API Endpoint
VITE_API_BASE_URL=https://api.veloop.gg/v1

# Feature Flags
VITE_ENABLE_ANALYTICS=false

# Default Player Progression Preset
VITE_DEFAULT_LEVEL=4
VITE_DEFAULT_XP=6420
